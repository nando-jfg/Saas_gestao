<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold"><%= @empresa.nome %></h1>
  <% if policy(@empresa).edit? %>
    <%= link_to "Editar", edit_empresa_path, class: "text-sm text-blue-600 hover:underline" %>
  <% end %>
</div>

<dl class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100 text-sm">
  <div class="px-4 py-3 flex justify-between">
    <dt class="text-gray-500">Nome</dt>
    <dd class="font-medium"><%= @empresa.nome %></dd>
  </div>
  <div class="px-4 py-3 flex justify-between">
    <dt class="text-gray-500">Colaboradores</dt>
    <dd class="font-medium"><%= link_to @empresa.usuarios.count, colaboradores_path, class: "text-blue-600 hover:underline" %></dd>
  </div>
</dl>
