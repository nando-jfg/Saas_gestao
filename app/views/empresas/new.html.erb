<div class="max-w-sm mx-auto mt-4">
  <div class="text-center mb-6">
    <h1 class="text-xl font-semibold">Crie sua empresa</h1>
    <p class="text-sm text-gray-500 mt-1">Para começar a usar o sistema, cadastre a empresa que você administra.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-6 py-8 sm:px-8">
    <%= form_with model: @empresa, url: empresa_path, method: :post do |f| %>
      <%= render "shared/form_errors", object: @empresa %>

      <div>
        <%= f.label :nome, "Nome da empresa", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :nome, autofocus: true, placeholder: "Ex: Padaria do Zé",
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>

      <div class="mt-6">
        <%= f.submit "Criar empresa", class: "w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-md transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
