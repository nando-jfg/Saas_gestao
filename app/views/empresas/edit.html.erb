<div class="max-w-sm">
  <h1 class="text-xl font-semibold mb-6">Editar empresa</h1>

  <%= form_with model: @empresa, url: empresa_path, method: :patch do |f| %>
    <%= render "shared/form_errors", object: @empresa %>

    <div>
      <%= f.label :nome, "Nome da empresa", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nome, autofocus: true,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
    </div>

    <div class="mt-6">
      <%= f.submit "Salvar", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-md transition-colors cursor-pointer" %>
      <%= link_to "Cancelar", empresa_path, class: "ml-3 text-sm text-gray-500 hover:underline" %>
    </div>
  <% end %>
</div>
