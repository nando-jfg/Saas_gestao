<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Saas Gestao" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Saas Gestao">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <% if usuario_signed_in? %>
      <nav class="bg-white border-b border-gray-200 px-5 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "SaaS Gestão", root_path, class: "font-semibold" %>
          <% if current_empresa %>
            <span class="text-sm text-gray-500"><%= current_empresa.nome %></span>
            <%= link_to "Colaboradores", colaboradores_path, class: "text-sm text-gray-700 hover:underline" %>
          <% end %>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-gray-500"><%= current_usuario.email %></span>
          <%= button_to "Sair", destroy_usuario_session_path, method: :delete, class: "text-gray-700 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
        </div>
      </nav>
    <% end %>

    <main class="container mx-auto mt-10 px-5 max-w-2xl">
      <% if notice %>
        <p class="mb-4 rounded bg-green-50 text-green-800 px-4 py-2 text-sm"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-4 rounded bg-red-50 text-red-800 px-4 py-2 text-sm"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
