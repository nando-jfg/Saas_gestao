<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold">Colaboradores</h1>
  <%= link_to "Convidar colaborador", new_colaborador_path,
        class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-md transition-colors" %>
</div>

<% if @colaboradores.empty? %>
  <div class="bg-white border border-gray-200 rounded-lg px-6 py-10 text-center">
    <p class="text-sm text-gray-500">Nenhum colaborador cadastrado ainda.</p>
    <%= link_to "Convidar o primeiro colaborador", new_colaborador_path, class: "mt-2 inline-block text-sm text-blue-600 hover:underline" %>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left bg-gray-50 border-b border-gray-200 text-gray-500">
          <th class="py-2.5 px-4 font-medium">Nome</th>
          <th class="py-2.5 px-4 font-medium">E-mail</th>
          <th class="py-2.5 px-4 font-medium">Papel</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @colaboradores.each do |colaborador| %>
          <tr>
            <td class="py-2.5 px-4"><%= colaborador.nome %></td>
            <td class="py-2.5 px-4 text-gray-500"><%= colaborador.email %></td>
            <td class="py-2.5 px-4">
              <% if colaborador.admin? %>
                <span class="inline-block rounded-full bg-blue-50 text-blue-700 text-xs font-medium px-2.5 py-0.5">admin</span>
              <% else %>
                <span class="inline-block rounded-full bg-gray-100 text-gray-600 text-xs font-medium px-2.5 py-0.5">colaborador</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
