<div class="max-w-sm">
  <h1 class="text-xl font-semibold mb-2">Convidar colaborador</h1>
  <p class="text-sm text-gray-500 mb-6">Uma senha temporária será gerada e exibida uma única vez após o cadastro — compartilhe com o colaborador manualmente.</p>

  <%= form_with model: @colaborador, url: colaboradores_path do |f| %>
    <%= render "shared/form_errors", object: @colaborador %>

    <div class="space-y-4">
      <div>
        <%= f.label :nome, "Nome", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :nome, autofocus: true,
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>

      <div>
        <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email,
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>

      <div>
        <%= f.label :papel, "Papel", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :papel, Usuario.papels.keys.map { |p| [ p.humanize, p ] }, {}, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none bg-white" %>
      </div>
    </div>

    <div class="mt-6">
      <%= f.submit "Convidar", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-md transition-colors cursor-pointer" %>
      <%= link_to "Cancelar", colaboradores_path, class: "ml-3 text-sm text-gray-500 hover:underline" %>
    </div>
  <% end %>
</div>
