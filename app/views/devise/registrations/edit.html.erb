<h1 class="text-xl font-semibold mb-6">Minha conta</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="space-y-4 max-w-sm">
    <div>
      <%= f.label :nome, "Nome", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nome, autofocus: true,
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
    </div>

    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autocomplete: "email",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-sm text-amber-700 bg-amber-50 rounded px-3 py-2">
        Aguardando confirmação de: <%= resource.unconfirmed_email %>
      </p>
    <% end %>

    <hr class="border-gray-100">

    <div>
      <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <p class="text-xs text-gray-400 mb-1">Deixe em branco para não alterar</p>
      <%= f.password_field :password, autocomplete: "new-password",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-gray-400"><%= @minimum_password_length %> caracteres no mínimo</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
    </div>

    <div>
      <%= f.label :current_password, "Senha atual", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <p class="text-xs text-gray-400 mb-1">Necessária para confirmar as alterações</p>
      <%= f.password_field :current_password, autocomplete: "current-password",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
    </div>
  </div>

  <div class="mt-6">
    <%= f.submit "Salvar alterações", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-md transition-colors cursor-pointer" %>
  </div>
<% end %>

<div class="mt-10 max-w-sm border-t border-gray-100 pt-6">
  <h2 class="text-sm font-medium text-gray-700 mb-2">Cancelar minha conta</h2>
  <p class="text-xs text-gray-400 mb-3">Essa ação é permanente e não pode ser desfeita.</p>
  <%= button_to "Cancelar minha conta", registration_path(resource_name),
        data: { confirm: "Tem certeza?", turbo_confirm: "Tem certeza?" }, method: :delete,
        class: "text-red-600 hover:underline bg-transparent border-0 p-0 text-sm cursor-pointer" %>
</div>
