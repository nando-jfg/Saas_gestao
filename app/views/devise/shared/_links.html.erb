<div class="mt-6 text-center text-sm text-gray-500 space-y-2">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to "Entrar", new_session_path(resource_name), class: "text-blue-600 hover:underline font-medium" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p>Não tem conta? <%= link_to "Criar conta", new_registration_path(resource_name), class: "text-blue-600 hover:underline font-medium" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "Não recebeu as instruções de confirmação?", new_confirmation_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "Não recebeu as instruções de desbloqueio?", new_unlock_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p><%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "text-blue-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %></p>
    <% end %>
  <% end %>
</div>
